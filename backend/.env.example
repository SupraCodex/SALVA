# LOCAL DEVELOPMENT WITHOUT DOCKER ONLY: copy to backend/.env. Never commit the real file.
# Not used by `docker compose` (see ../.env.example) nor by online hosting (docs/deployment.md).
ENV=development
DATABASE_URL=postgresql+psycopg://salva:salva@localhost:5432/salva
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Automatic weather (Open-Meteo, no key). Set to false to work fully offline.
WEATHER_ENABLED=true
# Optional OSRM-compatible routing service; otherwise distances.csv then a labelled estimate.
ROUTING_BASE_URL=

# Explanation layer: template (no AI, default), gemini or openai.
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Demo workspace created by `python -m app.seed --reference --demo`.
DEMO_USER_EMAIL=demo@salva.example
DEMO_USER_PASSWORD=
