# LOCAL RUN WITH DOCKER ONLY: copy to .env, then `docker compose up`. Never commit the real file.
# Online hosting (Render) does not read this file: enter the variables in the service's
# Environment page instead (see docs/deployment.md).
ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=salva
ALLOWED_ORIGINS=http://localhost:8000
# Plain-HTTP local run: the refresh cookie must not require HTTPS. Remove behind HTTPS.
COOKIE_SECURE=false

# Automatic weather (Open-Meteo, no key). false = fully offline, a labelled default is used.
WEATHER_ENABLED=true
# Optional OSRM-compatible routing service; otherwise distances.csv then a labelled estimate.
ROUTING_BASE_URL=

# Explanation layer: template (default, no external call), gemini or openai.
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Demo workspace (design document scenario). true creates it at start-up.
SEED_DEMO=false
DEMO_USER_EMAIL=demo@salva.example
DEMO_USER_PASSWORD=
